# Anthropic (needed once the call webhook is wired up)
ANTHROPIC_API_KEY=

# Pinecone — integrated index handles embeddings server-side
PINECONE_API_KEY=
PINECONE_INDEX=voice-agent
PINECONE_EMBED_MODEL=llama-text-embed-v2
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Vapi (needed once phone numbers are wired up)
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# App
LOG_LEVEL=INFO
